root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Godot convention: tabs in GDScript and resource files
[*.{gd,tscn,tres,godot,cfg,dialogue}]
indent_style = tab
indent_size = 4

[*.{sh,yml,yaml,json,md,py}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
