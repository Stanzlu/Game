[gd_resource type="Resource" script_class="QuestDef" format=3]

[ext_resource type="Script" path="res://core/content/quest_def.gd" id="1_quest"]
[ext_resource type="Script" path="res://core/content/quest_stage_def.gd" id="2_stage"]

[sub_resource type="Resource" id="Resource_open"]
script = ExtResource("2_stage")
id = "open"
next = PackedStringArray("closed")

[sub_resource type="Resource" id="Resource_closed"]
script = ExtResource("2_stage")
id = "closed"
outcome = "done"

[resource]
script = ExtResource("1_quest")
id = "side_city_list"
kind = 1
stages = Array[ExtResource("2_stage")]([SubResource("Resource_open"), SubResource("Resource_closed")])
draft = false
