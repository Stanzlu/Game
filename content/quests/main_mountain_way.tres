[gd_resource type="Resource" script_class="QuestDef" format=3]

[ext_resource type="Script" path="res://core/content/quest_def.gd" id="1_quest"]
[ext_resource type="Script" path="res://core/content/quest_stage_def.gd" id="2_stage"]

[sub_resource type="Resource" id="Resource_climb"]
script = ExtResource("2_stage")
id = "climb"
next = PackedStringArray("valley")

[sub_resource type="Resource" id="Resource_valley"]
script = ExtResource("2_stage")
id = "valley"
next = PackedStringArray("plant")

[sub_resource type="Resource" id="Resource_plant"]
script = ExtResource("2_stage")
id = "plant"
next = PackedStringArray("load")

[sub_resource type="Resource" id="Resource_load"]
script = ExtResource("2_stage")
id = "load"
outcome = "done"

[resource]
script = ExtResource("1_quest")
id = "main_mountain_way"
kind = 0
stages = Array[ExtResource("2_stage")]([SubResource("Resource_climb"), SubResource("Resource_valley"), SubResource("Resource_plant"), SubResource("Resource_load")])
draft = false
