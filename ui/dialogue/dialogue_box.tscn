[gd_scene format=3]

[ext_resource type="Script" path="res://ui/dialogue/dialogue_box.gd" id="1_box"]
[ext_resource type="PackedScene" path="res://addons/dialogue_manager/nodes/dialogue_label/dialogue_label.tscn" id="2_label"]
[ext_resource type="Script" path="res://addons/dialogue_manager/nodes/responses_menu/dialogue_responses_menu.gd" id="3_menu"]
[ext_resource type="Script" path="res://ui/dialogue/continue_marker.gd" id="4_marker"]
[ext_resource type="Script" path="res://ui/menus/menu_cursor.gd" id="5_cursor"]

[node name="DialogueBox" type="CanvasLayer"]
layer = 20
script = ExtResource("1_box")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Root"]
layout_mode = 1
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 52.0
offset_top = -80.0
offset_right = -52.0
offset_bottom = -12.0
grow_horizontal = 2
grow_vertical = 0
theme_type_variation = &"DialoguePanel"

[node name="Rows" type="VBoxContainer" parent="Root/Panel"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Text" parent="Root/Panel/Rows" instance=ExtResource("2_label")]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3

[node name="Responses" type="VBoxContainer" parent="Root/Panel/Rows" node_paths=PackedStringArray("response_template")]
